[Unit]
Description=kpod transcript API (WebVTT for episodes without a feed transcript)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User that owns /var/lib/kpod-transcript and can SSH to KTR_WORKER.
User=kpod
Environment=KTR_BIND=127.0.0.1
Environment=KTR_PORT=8777
Environment=KTR_CACHE=/var/lib/kpod-transcript
Environment=KTR_WHISPER=/srv/kpod-transcript/whisper-cli
Environment=KTR_MODEL=/srv/kpod-transcript/ggml-small.en.bin
# SSH host that runs transcribe.sh. Empty runs whisper on this machine.
Environment=KTR_WORKER=
ExecStart=/usr/bin/python3 /srv/kpod-transcript/kpod-transcript.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
