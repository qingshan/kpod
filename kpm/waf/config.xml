<?xml version="1.0"?>
<widget id="dev.qingshan.kpod" version="1.0" viewmodes="application"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:kindle="http://kindle.amazon.com/ns/widget-extensions">

    <name xml:lang="en">kpod</name>
    <description xml:lang="en">Podcast player with OPML subscriptions; the WAF is a remote control (no HTML5 media on this WebKit)</description>

    <!-- The single HTML page Mesquite loads for this WAF. -->
    <content src="index.html" />

    <!-- Kindle object APIs this WAF is allowed to use (see config.xml docs
         at https://kindlemodding.org/wafs-and-mesquite/understanding-config-xml.html). -->
    <feature name="http://kindle.amazon.com/apis" required="true">
        <param name="appmgr" value="yes" />
        <param name="messaging" value="yes" />
        <param name="chrome" value="yes" />
        <param name="gestures" value="yes" />
    </feature>

    <!-- Tap must stay enabled. Swipe-only mode swallows button presses. -->
    <kindle:gestures>
        <kindle:param name="tap" value="yes" />
        <kindle:param name="swipe" value="yes" />
    </kindle:gestures>

    <!-- LIPC app IDs this WAF is allowed to message: chromebar for the
         title/close bar, kpodd (the daemon bundled with this package)
         to run sync/refresh/delete ops. -->
    <kindle:messaging>
        <kindle:app name="com.lab126.chromebar" value="yes" />
        <kindle:app name="dev.qingshan.kpodd" value="yes" />
    </kindle:messaging>

    <kindle:settings>
        <kindle:setting name="internetRequired" value="no" />
        <kindle:setting name="saveContext" value="no" />
    </kindle:settings>
</widget>
